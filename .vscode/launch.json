{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FastAPI Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--host", "127.0.0.1",
                "--port", "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/app",
            "console": "integratedTerminal",
            "jinja": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/app"
            }
        }
    ]
}